# Contrato 1.6.0: este archivo no llega al contenedor; consul-config lo carga en el KV
# de Consul (config/orquestador/) y el orquestador lo lee de ahí al arrancar.
# Descubrimiento por Consul, sin fallback a URLs fijas: si Consul no responde o no hay
# instancias sanas, 503 DEPENDENCY_UNAVAILABLE.
CONSUL_FALLBACK_ENABLED=false
REQUEST_TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=2
RETRY_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
# Registro propio en Consul. Los tags son las reglas con las que Traefik lo publica
# (antes labels del compose): Host, HTTPS, cortocircuito y límite de tasa. El
# cortocircuito no cuenta el 503 (backpressure de extracción) y el límite deja pasar
# las pruebas de carga (30-90 PDF/s). El Host tiene que coincidir con ORQUESTADOR_HOST.
CONSUL_SERVICE_ADDRESS=orquestador
CONSUL_SERVICE_PORT=8000
CONSUL_SERVICE_TAGS=["traefik.enable=true", "traefik.http.routers.orquestador.rule=Host(`pdf.universidad.localhost`)", "traefik.http.routers.orquestador.entrypoints=https", "traefik.http.routers.orquestador.tls=true", "traefik.http.routers.orquestador.middlewares=orquestador-cortocircuito,orquestador-limite", "traefik.http.middlewares.orquestador-cortocircuito.circuitbreaker.expression=NetworkErrorRatio() > 0.30 || ResponseCodeRatio(500, 503, 0, 600) > 0.30", "traefik.http.middlewares.orquestador-limite.ratelimit.average=200", "traefik.http.middlewares.orquestador-limite.ratelimit.burst=100"]
