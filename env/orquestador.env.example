# Descubrimiento por Consul (token de solo lectura, como Docker secret). Sin fallback a
# URLs fijas: si Consul no responde o no hay instancias sanas, 503 DEPENDENCY_UNAVAILABLE.
CONSUL_ENABLED=true
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=/run/secrets/consul_orchestrator_token
CONSUL_FALLBACK_ENABLED=false
REQUEST_TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=2
RETRY_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
