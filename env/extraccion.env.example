LOG_LEVEL=INFO
# Espera máxima en la cola de extracción: menor que REQUEST_TIMEOUT_SECONDS del orquestador
# (10 s), o el orquestador corta y reintenta una request que sigue en cola (contrato 1.4.0).
EXTRACT_QUEUE_TIMEOUT_SECONDS=5
CONSUL_ENABLED=true
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=/run/secrets/consul_microservices_token
CONSUL_SERVICE_PORT=8000
# Sin CONSUL_SERVICE_ADDRESS a propósito: cada réplica se registra con su propia IP, así
# Consul controla la salud de cada una y el orquestador reparte entre las sanas.
