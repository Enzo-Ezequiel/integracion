            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('error con el formato común', () => {",
              "  const e = pm.response.json().error;",
              "  pm.expect(e.code).to.eql('DUPLICATE_CHECKSUM');",
              "  pm.expect(e).to.have.all.keys('code', 'message', 'details', 'correlation_id');",
              "  pm.expect(e.correlation_id).to.eql(pm.variables.get('correlationId'));",
              "});",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
