          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/pdf",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "pdf"
