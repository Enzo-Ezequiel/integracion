{
  "info": {
    "name": "validacion-pdf",
    "description": "POST /validar del contrato microservicios-pdf v1.0.0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /health",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/health",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "POST /validar - PDF válido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('valido y tamaño', () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.valido).to.eql(true);",
              "  pm.expect(r.nombre).to.eql('contrato.pdf');",
              "  pm.expect(r.tamano_bytes).to.be.above(0);",
              "});",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/validar",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "validar"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"archivo_base64\": \"{{pdfBase64}}\",\n  \"nombre\": \"contrato.pdf\"\n}"
        }
      }
    },
    {
      "name": "POST /validar - no es PDF → 422 PDF_INVALID",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test('error con el formato común', () => {",
              "  const e = pm.response.json().error;",
              "  pm.expect(e.code).to.eql('PDF_INVALID');",
              "  pm.expect(e).to.have.all.keys('code', 'message', 'details', 'correlation_id');",
              "  pm.expect(e.correlation_id).to.eql(pm.variables.get('correlationId'));",
              "});",
              "pm.test('valido false', () => pm.expect(pm.response.json().valido).to.eql(false));",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/validar",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "validar"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"archivo_base64\": \"{{noPdfBase64}}\",\n  \"nombre\": \"texto.pdf\"\n}"
        }
      }
    },
    {
      "name": "POST /validar - sin nombre → 400 VALIDATION_ERROR",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "pm.test('error con el formato común', () => {",
              "  const e = pm.response.json().error;",
              "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(e).to.have.all.keys('code', 'message', 'details', 'correlation_id');",
              "  pm.expect(e.correlation_id).to.eql(pm.variables.get('correlationId'));",
              "});",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/validar",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "validar"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"archivo_base64\": \"{{pdfBase64}}\"\n}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseURL",
      "value": "http://localhost:8000"
    },
    {
      "key": "pdfBase64",
      "value": ""
    },
    {
      "key": "noPdfBase64",
      "value": "ZXN0byBubyBlcyB1biBQREY="
    },
    {
      "key": "pdfCorruptoBase64",
      "value": "JVBERi0xLjQKYmFzdXJhIHNpbiBlc3RydWN0dXJh"
    }
  ]
}
