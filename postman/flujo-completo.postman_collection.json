{
  "info": {
    "name": "flujo-completo",
    "description": "Recorrido completo por el único punto público (orquestador). Genera un PDF distinto en cada corrida para que el alta dé 201. Para ver el recorrido: docker compose logs | grep <correlationId>.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /health",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/health",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "1. POST /pdf - alta de un PDF nuevo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));",
              "// PDF mínimo con un texto distinto en cada corrida → checksum nuevo.",
              "const marca = pm.variables.replaceIn('{{$guid}}');",
              "const contenido = `BT /F1 12 Tf 72 720 Td (Flujo ${marca}) Tj ET`;",
              "const objetos = [",
              "  '<< /Type /Catalog /Pages 2 0 R >>',",
              "  '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',",
              "  '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>',",
              "  `<< /Length ${contenido.length} >>\\nstream\\n${contenido}\\nendstream`,",
              "  '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',",
              "];",
              "let pdf = '%PDF-1.4\\n';",
              "const offsets = [];",
              "objetos.forEach((o, i) => { offsets.push(pdf.length); pdf += `${i + 1} 0 obj\\n${o}\\nendobj\\n`; });",
              "const xref = pdf.length;",
              "pdf += `xref\\n0 ${objetos.length + 1}\\n0000000000 65535 f \\n`;",
              "offsets.forEach(o => { pdf += `${String(o).padStart(10, '0')} 00000 n \\n`; });",
              "pdf += `trailer\\n<< /Size ${objetos.length + 1} /Root 1 0 R >>\\nstartxref\\n${xref}\\n%%EOF\\n`;",
              "pm.variables.set('pdfUnicoBase64', btoa(pdf));",
              "pm.collectionVariables.set('marca', marca);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('documento del modelo común', () => {",
              "  const d = pm.response.json();",
              "  pm.expect(d).to.include.all.keys('id', 'nombre', 'checksum', 'texto', 'tamano_bytes', 'paginas', 'created_at', 'updated_at');",
              "  pm.expect(d.created_at).to.match(/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$/);",
              "});",
              "pm.test('el texto extraído es el del PDF', () => pm.expect(pm.response.json().texto).to.include(pm.collectionVariables.get('marca')));",
              "pm.test('una página', () => pm.expect(pm.response.json().paginas).to.eql(1));",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/pdf",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "pdf"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"archivo_base64\": \"{{pdfUnicoBase64}}\",\n  \"nombre\": \"flujo.pdf\"\n}"
        }
      }
    },
    {
      "name": "2. POST /pdf - el mismo PDF → 409 DUPLICATE_CHECKSUM",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));",
              "// Reutiliza el PDF del paso 1 (variable de corrida)."
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('error con el formato común', () => {",
              "  const e = pm.response.json().error;",
              "  pm.expect(e.code).to.eql('DUPLICATE_CHECKSUM');",
              "  pm.expect(e).to.have.all.keys('code', 'message', 'details', 'correlation_id');",
              "  pm.expect(e.correlation_id).to.eql(pm.variables.get('correlationId'));",
              "});",
              "pm.test('devuelve el X-Correlation-ID enviado', () => {",
              "  pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseURL}}/pdf",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "pdf"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"archivo_base64\": \"{{pdfUnicoBase64}}\",\n  \"nombre\": \"flujo.pdf\"\n}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseURL",
      "value": "https://pdf.universidad.localhost"
    },
    {
      "key": "marca",
      "value": ""
    }
  ]
}
