# Variables del compose: versiones de imagen y host público del orquestador, que usa el
# humo de levantar.sh. Tiene que coincidir con el Host de CONSUL_SERVICE_TAGS en
# env/orquestador.env (contrato 1.6.0: Traefik lo toma de Consul, no de este archivo).
ORQUESTADOR_VERSION=1.2.0
VALIDACION_VERSION=1.2.0
EXTRACCION_VERSION=1.3.1
ACTUALIZACIONES_VERSION=1.1.0
CONSULTAS_VERSION=1.1.0
ORQUESTADOR_HOST=pdf.universidad.localhost
# Carpeta con los tokens que deja el bootstrap de Consul. Por defecto la del repo de
# infraestructura clonado como ../dockers.
# CONSUL_TOKENS_DIR=../dockers/consul/generated
